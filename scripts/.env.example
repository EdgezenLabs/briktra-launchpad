# Copy this file to scripts/.env and fill in the values.
# This file is checked into version control as a template only -- never commit scripts/.env.

# PBKDF2 password-hashing salt GUID used by the regression runner.
BRIKTRA_SALT_GUID=

# Tenant test account credentials
BRIKTRA_TEST_EMAIL=
BRIKTRA_PASSWORD=

# Request-signing HMAC secret (either name works)
BRIKTRA_SIGNING_SECRET=
# REQUEST_SIGNATURE_SECRET=

