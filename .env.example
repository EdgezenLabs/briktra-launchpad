# Site origins (vite). Production builds default to https://app.briktra.com and
# https://api.briktra.com; development and qa modes read .env.development / .env.qa.
# VITE_APP_URL=
# VITE_API_URL=

# Regression scripts in scripts/ (QA only). Copy to scripts/.env, which is
# gitignored, and fill in. Never put real passwords or secrets in this file.
