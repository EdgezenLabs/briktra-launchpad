BRIKTRA_UI_URL=https://qa-rehearsal.briktra-app.pages.dev
BRIKTRA_SALT_GUID=
BRIKTRA_SIGNING_SECRET=

TENANT_EMAIL=
TENANT_PASSWORD=

MANAGER_EMAIL=
MANAGER_PASSWORD=

SUPERVISOR_EMAIL=
SUPERVISOR_PASSWORD=

EMPLOYEE_EMAIL=
EMPLOYEE_PASSWORD=
